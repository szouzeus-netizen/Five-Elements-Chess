{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "five-elements-chess",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "WUXING", "class_name": "WuxingGame" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WuxingGame"] }
  ]
}
